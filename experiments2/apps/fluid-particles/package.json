{
  "name": "@experiments2/fluid-particles",
  "version": "1.0.0",
  "description": "WebGPU particles driven by a 3D fluid simulation using Belfast",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-tests/*.test.js",
    "lint": "eslint src",
    "clean": "rm -rf dist .tmp-tests"
  },
  "dependencies": {
    "@fluid-sim-belfast": "workspace:*",
    "belfast": "workspace:*",
    "gl-matrix": "^3.4.3",
    "lil-gui": "^0.19.1",
    "scheduling": "^1.0.0",
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/stats.js": "^0.17.4",
    "@webgpu/types": "^0.1.44",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
