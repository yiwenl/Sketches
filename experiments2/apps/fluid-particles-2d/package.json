{
  "name": "@experiments2/fluid-particles-2d",
  "version": "1.0.0",
  "description": "WebGPU particles driven by a 2D fluid simulation using Belfast",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-tests/*.test.js",
    "lint": "eslint src",
    "clean": "rm -rf dist .tmp-tests"
  },
  "dependencies": {
    "@effect-composer-ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fluid-sim": "workspace:*",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@tweakpane/core": "^2.0.5",
    "belfast": "workspace:*",
    "gl-matrix": "^3.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "scheduling": "^1.0.0",
    "stats.js": "^0.17.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/stats.js": "^0.17.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.44",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
